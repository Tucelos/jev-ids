# Copy to `.env` (git-ignored) and fill only what you actually run.
# Nothing here is read at import time: a Detector or a curator asks for its key on its first call.

# --- The Detector: Jev, TypeSafe's System One Model ---------------------------
# Which door to reach Jev through: `typesafe` (the SDK, the default) or `vercel` (the AI Gateway).
JEV_GATEWAY=typesafe
# For JEV_GATEWAY=typesafe. Read by the TypeSafe SDK itself.
TYPESAFE_API_KEY=
# For JEV_GATEWAY=vercel. The gateway masks the model version as `typesafe-ai/jev`.
AI_GATEWAY_API_KEY=

# --- The Arena's LLM agents: curator and, optionally, attacker ----------------
# Pick the provider in configs/arena.toml; only that provider's key is needed.
# OpenAI's official API (not the ChatGPT subscription path below).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Ollama on another machine over an SSH tunnel. The default port is 11434.
OLLAMA_HOST=http://localhost:11435

# --- Upstream's other LLM baselines, kept from the fork -----------------------
# GPT through the ChatGPT Codex backend: OAuth, not an API key. See jev_ids/detectors/chatgpt.py.
CHATGPT_CLIENT_ID=
CHATGPT_TOKEN_PATH=
# Gemini through Vertex AI: credentials come from `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
